    },
    "Organization": {
      "$comment": "failed to fetch URL: https://usgin.github.io/metadataBuildingBlocks/_sources/schemaorgProperties/organization/schema.yaml"
    },
    "EcrrCommon_LabeledLink": {
      "$comment": "failed to fetch URL: https://usgin.github.io/metadataBuildingBlocks/_sources/schemaorgProperties/labeledLink/schema.yaml"
    },
    "EcrrAssessment_DefinedTerm": {
      "$comment": "failed to fetch URL: https://usgin.github.io/metadataBuildingBlocks/_sources/schemaorgProperties/definedTerm/schema.yaml"
    },
    "EcrrAssessment_Person": {
      "$comment": "failed to fetch URL: https://usgin.github.io/metadataBuildingBlocks/_sources/schemaorgProperties/person/schema.yaml"
    },
    "EcrrAssessment_Organization": {
      "$comment": "failed to fetch URL: https://usgin.github.io/metadataBuildingBlocks/_sources/schemaorgProperties/organization/schema.yaml"
    }
  }
}
