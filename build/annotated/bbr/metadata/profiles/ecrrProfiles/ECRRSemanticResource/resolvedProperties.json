{"defs":{},"properties":[{"path":["schema:name"],"id":"http://schema.org/name","description":"The name of the resource.","required":true,"schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCore"],"effectiveId":"http://schema.org/name"},{"path":["schema:description"],"id":"http://schema.org/description","description":"A text description of the resource, providing enough detail for discovery and basic understanding of the resource purpose and content.","required":true,"schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCore"],"effectiveId":"http://schema.org/description"},{"path":["schema:mainEntity"],"id":"http://schema.org/mainEntity","description":"ECRR resource type classification. Array of labeled links (CreativeWork objects) with name and url pointing to ECRRO resource type URIs. The first entry identifies the base resource type (e.g. Software, Service Instance, Specification). Additional entries may specify subtypes from SPKT_ or srt_ vocabularies.","required":true,"sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCore"],"effectiveId":"http://schema.org/mainEntity"},{"path":["schema:license"],"id":"http://schema.org/license","description":"Legal conditions governing use and access. Array of labeled links identifying the license(s), ideally with URIs from https://spdx.org/licenses/ or http://cor.esipfed.org/ont/earthcube/swl.","required":true,"schema_type":"array","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCore"],"effectiveId":"http://schema.org/license"},{"path":["schema:identifier"],"id":"http://schema.org/identifier","description":"External identifier for the resource (e.g. DOI, ARK). Use PropertyValue pattern to specify identifier scheme and resolver URL.","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:url"],"id":"http://schema.org/url","description":"URL of a landing page or web resource describing the resource.","schema_type":"string","format":"uri","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/url"},{"path":["schema:datePublished"],"id":"http://schema.org/datePublished","description":"ISO 8601 formatted date when the resource was published or released.","schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/datePublished"},{"path":["schema:version"],"id":"http://schema.org/version","description":"Version number or identifier for this resource.","schema_type":["string","number"],"sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/version"},{"path":["schema:alternateName"],"id":"http://schema.org/alternateName","description":"Alternative names by which the resource is known.","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/alternateName"},{"path":["schema:sameAs"],"id":"http://schema.org/sameAs","description":"Other identifiers or URIs for the same resource.","schema_type":"array","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/sameAs"},{"path":["schema:creator"],"id":"http://schema.org/creator","description":"Authors or originators of the resource content: an array of Person or Organization objects, or that array in a JSON-LD @list wrapper to preserve author order (CDIF's form).","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/creator"},{"path":["schema:contributor"],"id":"http://schema.org/contributor","description":"Other parties who contributed to the resource.","schema_type":"array","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/contributor"},{"path":["schema:publisher"],"id":"http://schema.org/publisher","description":"Party that made the resource publicly available.","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/publisher"},{"path":["schema:editor"],"id":"http://schema.org/editor","description":"Editors of the resource.","schema_type":"array","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/editor"},{"path":["schema:funding"],"id":"http://schema.org/funding","description":"Funding sources and grants that supported the resource.","schema_type":"array","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/funding"},{"path":["schema:funding","schema:identifier"],"id":"http://schema.org/identifier","description":"identifier for a particular grant","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.monetaryGrant"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:funding","schema:description"],"id":"http://schema.org/description","description":"description of the funding or grant","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.monetaryGrant"],"effectiveId":"http://schema.org/description"},{"path":["schema:funding","schema:name"],"id":"http://schema.org/name","description":"title of the grant","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.monetaryGrant"],"effectiveId":"http://schema.org/name"},{"path":["schema:funding","schema:funder"],"id":"http://schema.org/funder","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.monetaryGrant"],"effectiveId":"http://schema.org/funder"},{"path":["schema:keywords"],"id":"http://schema.org/keywords","description":"Free-text keywords describing the resource content.","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/keywords"},{"path":["schema:about"],"id":"http://schema.org/about","description":"Science domains that the resource addresses. Array of DefinedTerm objects referencing the ECRR ADO (Academic Discipline Ontology) vocabulary.","schema_type":"array","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/about"},{"path":["schema:audience"],"id":"http://schema.org/audience","description":"Target user communities for the resource. Array of Audience objects with audienceType labels and identifiers from the AUT vocabulary.","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/audience"},{"path":["schema:subjectOf"],"id":"http://schema.org/subjectOf","description":"Metadata about this resource: the CDIF catalog record for this metadata (typed schema:Dataset, with dcat:CatalogRecord as its schema:additionalType), and/or labeled links (CreativeWork objects with name and url) to formal metadata records or web pages about the resource.","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/subjectOf"},{"path":["schema:isRelatedTo"],"id":"http://schema.org/isRelatedTo","description":"Related resources such as documentation, publications, or tools. Array of labeled links.","schema_type":"array","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/isRelatedTo"},{"path":["schema:isBasedOn"],"id":"http://schema.org/isBasedOn","description":"Resources (e.g. semantic resources, specifications) that this resource is based on or derived from. Array of labeled links.","schema_type":"array","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/isBasedOn"},{"path":["schema:encodingFormat"],"id":"http://schema.org/encodingFormat","description":"Representation formats for the resource content (e.g. MIME types, format names like RDF/XML, Turtle, JSON-LD).","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/encodingFormat"},{"path":["dct:bibliographicCitation"],"id":"http://purl.org/dc/terms/bibliographicCitation","description":"Preferred bibliographic citation for the resource, encoded as a PropertyValue with propertyID of dct:bibliographicCitation.","schema_type":"object","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://purl.org/dc/terms/bibliographicCitation"},{"path":["dct:bibliographicCitation","schema:propertyID"],"id":"http://schema.org/propertyID","required":true,"schema_type":"string","const":"dct:bibliographicCitation","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/propertyID"},{"path":["dct:bibliographicCitation","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/name"},{"path":["dct:bibliographicCitation","schema:value"],"id":"http://schema.org/value","required":true,"schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/value"},{"path":["dct:conformsTo"],"id":"http://purl.org/dc/terms/conformsTo","description":"Specifications or standards that the resource conforms to. Array of labeled links.","schema_type":"array","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://purl.org/dc/terms/conformsTo"},{"path":["ecrro:ECRRO_0000138"],"id":"http://cor.esipfed.org/ont/earthcube/ECRRO_0000138","description":"Maturity state of the resource. Value is a DefinedTerm from the MTU (Maturity) vocabulary (e.g. In production, Alpha, Planning).","schema_type":"object","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://cor.esipfed.org/ont/earthcube/ECRRO_0000138"},{"path":["ecrro:ECRRO_0000138","schema:propertyID"],"id":"http://schema.org/propertyID","required":true,"schema_type":"string","const":"ecrro:ECRRO_0000138","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/propertyID"},{"path":["ecrro:ECRRO_0000138","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/name"},{"path":["ecrro:ECRRO_0000138","schema:value"],"id":"http://schema.org/value","required":true,"sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/value"},{"path":["ecrro:ECRRO_0000219"],"id":"http://cor.esipfed.org/ont/earthcube/ECRRO_0000219","description":"Expected lifetime of the resource. Value is a DefinedTerm from the ELT (Expected Lifetime) vocabulary (e.g. Long-term, >5 years, 1-5 years).","schema_type":"object","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://cor.esipfed.org/ont/earthcube/ECRRO_0000219"},{"path":["ecrro:ECRRO_0000219","schema:propertyID"],"id":"http://schema.org/propertyID","required":true,"schema_type":"string","const":"ecrro:ECRRO_0000219","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/propertyID"},{"path":["ecrro:ECRRO_0000219","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/name"},{"path":["ecrro:ECRRO_0000219","schema:value"],"id":"http://schema.org/value","required":true,"sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/value"},{"path":["ecrro:ECRRO_0000017"],"id":"http://cor.esipfed.org/ont/earthcube/ECRRO_0000017","description":"Current usage level of the resource. Value is a DefinedTerm from the UBA (Usage) vocabulary (e.g. Wide usage, Some usage, Low usage).","schema_type":"object","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://cor.esipfed.org/ont/earthcube/ECRRO_0000017"},{"path":["ecrro:ECRRO_0000017","schema:propertyID"],"id":"http://schema.org/propertyID","required":true,"schema_type":"string","const":"ecrro:ECRRO_0000017","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/propertyID"},{"path":["ecrro:ECRRO_0000017","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/name"},{"path":["ecrro:ECRRO_0000017","schema:value"],"id":"http://schema.org/value","required":true,"sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/value"},{"path":["ecrro:ECRRO_0000218"],"id":"http://cor.esipfed.org/ont/earthcube/ECRRO_0000218","description":"Stewardship or maintainer of the resource. Value is an agent (Person or Organization) or array of agents responsible for maintenance.","schema_type":"object","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://cor.esipfed.org/ont/earthcube/ECRRO_0000218"},{"path":["ecrro:ECRRO_0000218","schema:propertyID"],"id":"http://schema.org/propertyID","required":true,"schema_type":"string","const":"ecrro:ECRRO_0000218","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/propertyID"},{"path":["ecrro:ECRRO_0000218","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/name"},{"path":["ecrro:ECRRO_0000218","schema:value"],"id":"http://schema.org/value","required":true,"sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/value"},{"path":["ecrro:ECRRO_0000600"],"id":"http://cor.esipfed.org/ont/earthcube/ECRRO_0000600","description":"Primary publication about the resource. Value is a citation string.","schema_type":"object","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://cor.esipfed.org/ont/earthcube/ECRRO_0000600"},{"path":["ecrro:ECRRO_0000600","schema:propertyID"],"id":"http://schema.org/propertyID","required":true,"schema_type":"string","const":"ecrro:ECRRO_0000600","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/propertyID"},{"path":["ecrro:ECRRO_0000600","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/name"},{"path":["ecrro:ECRRO_0000600","schema:value"],"id":"http://schema.org/value","required":true,"schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/value"},{"path":["ecrro:ECRRO_0001301"],"id":"http://cor.esipfed.org/ont/earthcube/ECRRO_0001301","description":"Registration metadata recording who registered the resource and when. Value is a StructuredValue with contributor (Person) and datePublished.","schema_type":"object","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://cor.esipfed.org/ont/earthcube/ECRRO_0001301"},{"path":["ecrro:ECRRO_0001301","schema:propertyID"],"id":"http://schema.org/propertyID","required":true,"schema_type":"string","const":"ecrro:ECRRO_0001301","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/propertyID"},{"path":["ecrro:ECRRO_0001301","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/name"},{"path":["ecrro:ECRRO_0001301","schema:value"],"id":"http://schema.org/value","required":true,"schema_type":"object","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/value"},{"path":["ecrro:ECRRO_0001301","schema:value","schema:additionalType"],"id":"http://schema.org/additionalType","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/additionalType"},{"path":["ecrro:ECRRO_0001301","schema:value","schema:contributor"],"id":"http://schema.org/contributor","required":true,"sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/contributor"},{"path":["ecrro:ECRRO_0001301","schema:value","schema:datePublished"],"id":"http://schema.org/datePublished","required":true,"schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/datePublished"},{"path":["schema:programmingLanguage"],"id":"http://schema.org/programmingLanguage","description":"The representation language of the semantic resource (e.g. OWL, SKOS, RDF). Can be a string or a ComputerLanguage object with name and identifier referencing the MOLA vocabulary.","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrSemanticResource"],"effectiveId":"http://schema.org/programmingLanguage"},{"path":["schema:additionalType"],"id":"http://schema.org/additionalType","sources":["bblocks://ecrr.bbr.metadata.profiles.ecrrProfiles.ECRRSemanticResource"],"effectiveId":"http://schema.org/additionalType"},{"path":["schema:mainEntity","_anyOf","0","dcat:hadRole","_anyOf","1","_anyOf","2"],"title":"a","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"keyword":"branch"},{"path":["schema:mainEntity","_anyOf","0","dcat:hadRole","_anyOf","1","_anyOf","2","skos:narrower"],"id":"http://www.w3.org/2004/02/skos/core#narrower","description":"Narrower (child) concepts in the hierarchy. Items are inline concept objects or @id references.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#narrower"},{"path":["schema:mainEntity","_anyOf","0","dcat:hadRole","_anyOf","1","_anyOf","2","skos:broader"],"id":"http://www.w3.org/2004/02/skos/core#broader","description":"Broader (parent) concepts in the hierarchy. Items are inline concept objects or @id references.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#broader"},{"path":["schema:mainEntity","_anyOf","0","dcat:hadRole","_anyOf","1","_anyOf","2","skos:topConceptOf"],"id":"http://www.w3.org/2004/02/skos/core#topConceptOf","description":"Concept scheme(s) for which this is a top concept.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#topConceptOf"},{"path":["schema:mainEntity","_anyOf","0","dcat:hadRole","_anyOf","1","_anyOf","2","skos:inScheme"],"id":"http://www.w3.org/2004/02/skos/core#inScheme","description":"Concept scheme(s) this concept belongs to.","required":true,"sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#inScheme"},{"path":["schema:mainEntity","_anyOf","0","dcat:hadRole","_anyOf","1","_anyOf","2","skos:editorialNote"],"id":"http://www.w3.org/2004/02/skos/core#editorialNote","description":"Note for editors and maintainers.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#editorialNote"},{"path":["schema:mainEntity","_anyOf","0","dcat:hadRole","_anyOf","1","_anyOf","2","skos:changeNote"],"id":"http://www.w3.org/2004/02/skos/core#changeNote","description":"Note documenting a change.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#changeNote"},{"path":["schema:mainEntity","_anyOf","0","dcat:hadRole","_anyOf","1","_anyOf","2","skos:historyNote"],"id":"http://www.w3.org/2004/02/skos/core#historyNote","description":"Note about past state or use.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#historyNote"},{"path":["schema:mainEntity","_anyOf","0","dcat:hadRole","_anyOf","1","_anyOf","2","skos:note"],"id":"http://www.w3.org/2004/02/skos/core#note","description":"General note about this concept.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#note"},{"path":["schema:mainEntity","_anyOf","0","dcat:hadRole","_anyOf","1","_anyOf","2","skos:scopeNote"],"id":"http://www.w3.org/2004/02/skos/core#scopeNote","description":"Note clarifying meaning and/or intended use.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#scopeNote"},{"path":["schema:mainEntity","_anyOf","0","dcat:hadRole","_anyOf","1","_anyOf","2","skos:definition"],"id":"http://www.w3.org/2004/02/skos/core#definition","description":"Formal explanation of the meaning of this concept.","required":true,"sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#definition"},{"path":["schema:mainEntity","_anyOf","0","dcat:hadRole","_anyOf","1","_anyOf","2","skos:notation"],"id":"http://www.w3.org/2004/02/skos/core#notation","description":"Classification code for this concept within a scheme (a single notation string, consistent with CdifCodelistConcept).","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#notation"},{"path":["schema:mainEntity","_anyOf","0","dcat:hadRole","_anyOf","1","_anyOf","2","skos:prefLabel"],"id":"http://www.w3.org/2004/02/skos/core#prefLabel","description":"Preferred lexical label for this concept. A single string, a single language-tagged value, or an array of language-tagged values. Each language should appear at most once.","required":true,"sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#prefLabel"},{"path":["schema:mainEntity","_anyOf","0","dcat:hadRole","_anyOf","1","_anyOf","1","schema:termCode"],"id":"http://schema.org/termCode","description":"A representative code for this keyword in the controlled vocabulary. Analogous to skos:Notation","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/termCode"},{"path":["schema:mainEntity","_anyOf","0","dcat:hadRole","_anyOf","1","_anyOf","1","schema:inDefinedTermSet"],"id":"http://schema.org/inDefinedTermSet","description":"The controlled vocabulary responsible for this keyword, as EITHER a plain URI string identifying the vocabulary, OR an object reference ({\"@id\": \"<uri>\"}) to a vocabulary defined elsewhere in the document. Both forms are already in use across CDIF profiles and downstream ADA building blocks; permitting only the string form made the object form - the natural JSON-LD spelling of a reference - invalid, while this class's own union-type policy above explicitly anticipates both.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/inDefinedTermSet"},{"path":["schema:mainEntity","_anyOf","0","dcat:hadRole","_anyOf","1","_anyOf","1","schema:identifier"],"id":"http://schema.org/identifier","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:mainEntity","_anyOf","0","dcat:hadRole","_anyOf","1","_anyOf","1","schema:identifier","schema:propertyID"],"id":"http://schema.org/propertyID","description":"In this context for the schema:PropertyValue, this field is an identifier for the identifier schema, e.g. DOI, ARK.  Get values from https://registry.identifiers.org/registry/ for interoperability. URI-shape values MUST be serialized as JSON-LD IRI references ({\"@id\":\"...\"}) so they participate in RDF entailment; free-label strings remain valid as strings.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/propertyID"},{"path":["schema:mainEntity","_anyOf","0","dcat:hadRole","_anyOf","1","_anyOf","1","schema:identifier","schema:value"],"id":"http://schema.org/value","description":"the identifier string. E.g. 10.5066/F7VX0DMQ","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/value"},{"path":["schema:mainEntity","_anyOf","0","dcat:hadRole","_anyOf","1","_anyOf","1","schema:identifier","schema:url"],"id":"http://schema.org/url","description":"web-resolveable string for the identifier; host name part is location of a resolver that will return some representation for the given identifier value. E.g. https://doi.org/10.5066/F7VX0DMQ ","schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/url"},{"path":["schema:mainEntity","_anyOf","0","dcat:hadRole","_anyOf","1","_anyOf","1","schema:name"],"id":"http://schema.org/name","description":"text label for the term that is useful to human user","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/name"},{"path":["schema:mainEntity","dcterms:relation"],"id":"http://purl.org/dc/terms/relation","description":"The related resource -- the DCAT canonical pointer to what is being related to, which is distinct from schema:url, the presentation URL of the link itself.\nAn @id reference is the RECOMMENDED form and a string is permitted, which is DCMI's own position: \"Recommended practice is to identify the related resource by means of a URI. If this is not possible or feasible, a string conforming to a formal identification system may be provided.\" DCMI declares no rdfs:range for this property, and of the 13 DCMI properties carrying an \"intended to be used with non-literal values\" restriction, this is deliberately not one. dcat.ttl does not re-declare or constrain it at all -- the only triple mentioning it in the whole DCAT vocabulary is `dcat:distribution rdfs:subPropertyOf dcterms:relation`.\nSo objectReference-only would be stricter than both DCAT and DCMI and would reject a form the specification sanctions. The anyOf matches how schema:additionalType is handled here: both forms valid, the object form used in examples and required only where a `contains` pins a specific value.\nIt was string-only until 2026-10-01, which rejected the @id form outright. Reported from outside by a PSDI validator taking a things-not-strings approach (profile-core#16): their DCAT catalogue mirrors the DCAT-3 spec examples and wrote {\"@id\": ...}, which failed both layers -- while CDIF's own documented URI serialization policy (agents.md) says URI values SHOULD be {\"@id\": ...}. The register required the one form its own policy argues against.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.labeledLink"],"effectiveId":"http://purl.org/dc/terms/relation"},{"path":["schema:mainEntity","dcat:hadRole"],"id":"http://www.w3.org/ns/dcat#hadRole","description":"Role of the related resource. Present only on a link that expresses a relationship; a plain labeled link such as a license omits it.\nDCAT's declared range is dcat:Role (dcat.ttl: rdfs:range dcat:Role, and dcat:Role rdfs:subClassOf skos:Concept), so the DCAT-native form is a node typed dcat:Role. That form was NOT accepted here before 2026-10-01: this property was cdifConceptOrTermOrString alone, which matches a bare string, a sealed @id reference, a schema:DefinedTerm or a skos:Concept -- none of which a dcat:Role-typed node satisfies, because JSON Schema does no subclass reasoning.\ndcat:Role is added as a branch rather than replacing the others, so the DCAT-native form becomes valid without invalidating anything already written. Note this leaves CDIF LOOSER than DCAT, deliberately: DCAT's range is dcat:Role alone, and CDIF also accepts a plain skos:Concept, a DefinedTerm, an @id reference and a string. That is the same both-forms stance taken on dcterms:relation, and it is a choice rather than an oversight -- do not read the extra branches as something not yet tightened.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.labeledLink"],"effectiveId":"http://www.w3.org/ns/dcat#hadRole"},{"path":["schema:mainEntity","schema:url"],"id":"http://schema.org/url","schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.labeledLink"],"effectiveId":"http://schema.org/url"},{"path":["schema:mainEntity","schema:description"],"id":"http://schema.org/description","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.labeledLink"],"effectiveId":"http://schema.org/description"},{"path":["schema:mainEntity","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.labeledLink"],"effectiveId":"http://schema.org/name"},{"path":["schema:mainEntity","_then"],"sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.labeledLink"],"keyword":"then"},{"path":["schema:creator","schema:name"],"id":"http://schema.org/name","description":"string label for person that is meaningful for human users, should format consistently. Recommend 'Family Name, Given name' format.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/name"},{"path":["schema:creator","schema:description"],"id":"http://schema.org/description","description":"additional information about the agent or their relation to the described resource","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/description"},{"path":["schema:creator","schema:identifier"],"id":"http://schema.org/identifier","description":"identifier for person, recommend ORCID","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:creator","schema:alternateName"],"id":"http://schema.org/alternateName","description":"other labels by which the person might be known. A list when there are several; a single label may be a plain string, as JSON-LD framing writes a one-item list.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/alternateName"},{"path":["schema:creator","schema:affiliation"],"id":"http://schema.org/affiliation","description":"if affiliation is present, value must be a schema:Organization.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/affiliation"},{"path":["schema:creator","schema:affiliation","schema:additionalType"],"id":"http://schema.org/additionalType","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/additionalType"},{"path":["schema:creator","schema:affiliation","schema:name"],"id":"http://schema.org/name","description":"string label for organization that is meaningful for human users","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/name"},{"path":["schema:creator","schema:affiliation","schema:alternateName"],"id":"http://schema.org/alternateName","description":"other labels by which the organization might be known. A list when there are several; a single label may be a plain string, as JSON-LD framing writes a one-item list.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/alternateName"},{"path":["schema:creator","schema:affiliation","schema:description"],"id":"http://schema.org/description","description":"additional information about the agent or their relation to the described resource","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/description"},{"path":["schema:creator","schema:affiliation","schema:identifier"],"id":"http://schema.org/identifier","description":"identifier for organization","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:creator","schema:affiliation","schema:sameAs"],"id":"http://schema.org/sameAs","description":"other identifiers for the organization","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/sameAs"},{"path":["schema:creator","schema:contactPoint"],"id":"http://schema.org/contactPoint","description":"An email address or a contact web page (a form, an issue tracker), or both; at least one is required. Schema.org also allows telephone and postal contacts. A URL-only contact is ordinary in DCAT (a vcard:Kind with only vcard:hasURL), so requiring email made such records invalid.","schema_type":"object","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/contactPoint"},{"path":["schema:creator","schema:contactPoint","schema:email"],"id":"http://schema.org/email","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/email"},{"path":["schema:creator","schema:contactPoint","schema:url"],"id":"http://schema.org/url","schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/url"},{"path":["schema:creator","schema:sameAs"],"id":"http://schema.org/sameAs","description":"other identifiers for the person","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/sameAs"},{"path":["schema:audience","schema:audienceType"],"id":"http://schema.org/audienceType","description":"Label for the target audience (e.g. Data Producers, Scientists, Developers). Values from ECRR AUT vocabulary.","required":true,"schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/audienceType"},{"path":["schema:audience","schema:identifier"],"id":"http://schema.org/identifier","description":"URI from the ECRR AUT_ vocabulary.","schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrCommon"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:subjectOf","schema:additionalType"],"id":"http://schema.org/additionalType","description":"additional type assertions for the catalog record node. dcat:CatalogRecord is required.","required":true,"schema_type":"array","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifCatalogRecord"],"effectiveId":"http://schema.org/additionalType"},{"path":["schema:subjectOf","schema:about"],"id":"http://schema.org/about","description":"this must be the @id value of the node containing the resource description metadata","required":true,"sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifCatalogRecord"],"effectiveId":"http://schema.org/about"},{"path":["schema:subjectOf","dcterms:conformsTo"],"id":"http://purl.org/dc/terms/conformsTo","description":"uri for specifications that this metadata record conforms to. Minimimally should specify uri for CDIF discovery profile.","required":true,"schema_type":"array","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifCatalogRecord"],"effectiveId":"http://purl.org/dc/terms/conformsTo"},{"path":["schema:subjectOf","schema:maintainer"],"id":"http://schema.org/maintainer","description":"Identification of the agent that maintains the metadata, with contact information. Should include person name and affiliation, or position name and affiliation, or just organization name. e-mail address is preferred contact information.","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifCatalogRecord"],"effectiveId":"http://schema.org/maintainer"},{"path":["schema:subjectOf","schema:sdDatePublished"],"id":"http://schema.org/sdDatePublished","description":"date of most recent update to the metadata content","schema_type":"string","format":"date","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifCatalogRecord"],"effectiveId":"http://schema.org/sdDatePublished"},{"path":["schema:subjectOf","schema:includedInDataCatalog"],"id":"http://schema.org/includedInDataCatalog","description":"identify the source for the origin the metadata record.","schema_type":"object","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifCatalogRecord"],"effectiveId":"http://schema.org/includedInDataCatalog"},{"path":["schema:subjectOf","schema:includedInDataCatalog","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifCatalogRecord"],"effectiveId":"http://schema.org/name"},{"path":["schema:subjectOf","schema:includedInDataCatalog","schema:url"],"id":"http://schema.org/url","description":"locator to access a landing page for the collection or catalog","schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifCatalogRecord"],"effectiveId":"http://schema.org/url"},{"path":["schema:subjectOf","schema:includedInDataCatalog","schema:identifier"],"id":"http://schema.org/identifier","description":"identifier for the collection or catalog; use identifier_type to provide information on identifier scheme and context for identifier","sources":["bblocks://cdif.bbr.metadata.cdifDataType.cdifCatalogRecord"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:programmingLanguage","schema:identifier"],"id":"http://schema.org/identifier","description":"URI from the MOLA vocabulary","schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrSemanticResource"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:programmingLanguage","schema:name"],"id":"http://schema.org/name","description":"Name of the representation language (e.g. OWL, SKOS, RDF/XML)","required":true,"schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrSemanticResource"],"effectiveId":"http://schema.org/name"}]}