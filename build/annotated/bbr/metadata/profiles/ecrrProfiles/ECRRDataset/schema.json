{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "ECRR Dataset Profile",
  "description": "Complete ECRR metadata profile for dataset resources. Extends CDIF CoreDiscovery (core + discovery) with ecrrCore (mainEntity, @type contains CreativeWork, requires description and license) and ecrrAssessment (maturity, lifetime, usage, stewardship). CDIF properties take precedence for overlapping concerns (creator, keywords, subjectOf, distribution, etc.). ECRR-unique properties from ecrrCommon are included inline. ECRR subjectOf usage (links to other metadata formats) maps to schema:relatedLink with linkRelationship \"OtherMetadataFormat\" per CDIF convention. Resources must have schema:additionalType containing \"EC Dataset\".",
  "allOf": [
    {
      "$ref": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/annotated/bbr/metadata/profiles/cdifCompositeProfile/CoreDiscovery/schema.json"
    },
    {
      "$ref": "https://usgin.github.io/ecrrBuildingBlocks/build/annotated/bbr/metadata/ecrrProperties/ecrrCore/schema.json"
    },
    {
      "$ref": "https://usgin.github.io/ecrrBuildingBlocks/build/annotated/bbr/metadata/ecrrProperties/ecrrAssessment/schema.json"
    },
    {
      "properties": {
        "schema:additionalType": {
          "contains": {
            "enum": [
              "EC Dataset"
            ]
          },
          "x-jsonld-id": "http://schema.org/additionalType"
        },
        "schema:alternateName": {
          "description": "Alternative names by which the resource is known.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "x-jsonld-id": "http://schema.org/alternateName"
        },
        "schema:editor": {
          "description": "Editors of the resource.",
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "@id": {
                    "type": "string"
                  }
                }
              },
              {
                "$ref": "#/$defs/Person"
              },
              {
                "$ref": "#/$defs/Organization"
              }
            ]
          },
          "x-jsonld-id": "http://schema.org/editor"
        },
        "schema:about": {
          "description": "Science domains that the resource addresses. Array of DefinedTerm objects referencing the ECRR ADO (Academic Discipline Ontology) vocabulary.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DefinedTerm"
          },
          "x-jsonld-id": "http://schema.org/about"
        },
        "schema:audience": {
          "description": "Target user communities for the resource. Array of Audience objects with audienceType labels and identifiers from the AUT vocabulary.",
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "@type": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "contains": {
                    "const": "schema:Audience"
                  },
                  "minItems": 1,
                  "default": [
                    "schema:Audience"
                  ]
                },
                "schema:audienceType": {
                  "type": "string",
                  "description": "Label for the target audience (e.g. Data Producers, Scientists, Developers). Values from ECRR AUT vocabulary.",
                  "x-jsonld-id": "http://schema.org/audienceType"
                },
                "schema:identifier": {
                  "type": "string",
                  "description": "URI from the ECRR AUT_ vocabulary.",
                  "x-jsonld-id": "http://schema.org/identifier"
                }
              },
              "required": [
                "@type",
                "schema:audienceType"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "@type": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "contains": {
                      "const": "schema:Audience"
                    },
                    "minItems": 1,
                    "default": [
                      "schema:Audience"
                    ]
                  },
                  "schema:audienceType": {
                    "type": "string",
                    "description": "Label for the target audience (e.g. Data Producers, Scientists, Developers). Values from ECRR AUT vocabulary.",
                    "x-jsonld-id": "http://schema.org/audienceType"
                  },
                  "schema:identifier": {
                    "type": "string",
                    "description": "URI from the ECRR AUT_ vocabulary.",
                    "x-jsonld-id": "http://schema.org/identifier"
                  }
                },
                "required": [
                  "@type",
                  "schema:audienceType"
                ]
              }
            }
          ],
          "x-jsonld-id": "http://schema.org/audience"
        },
        "dct:bibliographicCitation": {
          "description": "Preferred bibliographic citation for the resource, encoded as a PropertyValue with propertyID of dct:bibliographicCitation.",
          "type": "object",
          "properties": {
            "@type": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "contains": {
                "const": "schema:PropertyValue"
              },
              "minItems": 1,
              "default": [
                "schema:PropertyValue"
              ]
            },
            "schema:propertyID": {
              "type": "string",
              "const": "dct:bibliographicCitation",
              "x-jsonld-id": "http://schema.org/propertyID"
            },
            "schema:name": {
              "type": "string",
              "default": "Bibliographic citation",
              "x-jsonld-id": "http://schema.org/name"
            },
            "schema:value": {
              "type": "string",
              "x-jsonld-id": "http://schema.org/value"
            }
          },
          "required": [
            "@type",
            "schema:propertyID",
            "schema:value"
          ],
          "x-jsonld-id": "http://purl.org/dc/terms/bibliographicCitation"
        }
      }
    }
  ],
  "$defs": {
    "DefinedTerm": {
      "$ref": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/annotated/bbr/metadata/schemaorgProperties/definedTerm/schema.json"
    },
    "Person": {
      "$ref": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/annotated/bbr/metadata/schemaorgProperties/person/schema.json"
    },
    "Organization": {
      "$ref": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/annotated/bbr/metadata/schemaorgProperties/organization/schema.json"
    }
  },
  "x-jsonld-extra-terms": {
    "ecrr": "https://n2t.net/ark:/23942/g2"
  },
  "x-jsonld-prefixes": {
    "schema": "http://schema.org/",
    "ecrro": "http://cor.esipfed.org/ont/earthcube/",
    "dct": "http://purl.org/dc/terms/",
    "dcat": "http://www.w3.org/ns/dcat#"
  },
  "x-bblocks-metadata": {
    "itemIdentifier": "ecrr.bbr.metadata.profiles.ecrrProfiles.ECRRDataset",
    "register": "https://usgin.github.io/ecrrBuildingBlocks/build/register.json",
    "version": "0.1",
    "dateOfLastChange": "2026-11-14"
  }
}