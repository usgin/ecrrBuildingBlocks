{"defs":{},"properties":[{"path":["schema:programmingLanguage"],"id":"http://schema.org/programmingLanguage","description":"The representation language of the semantic resource (e.g. OWL, SKOS, RDF). Can be a string or a ComputerLanguage object with name and identifier referencing the MOLA vocabulary.","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrSemanticResource"],"effectiveId":"http://schema.org/programmingLanguage"},{"path":["schema:programmingLanguage","schema:identifier"],"id":"http://schema.org/identifier","description":"URI from the MOLA vocabulary","schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrSemanticResource"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:programmingLanguage","schema:name"],"id":"http://schema.org/name","description":"Name of the representation language (e.g. OWL, SKOS, RDF/XML)","required":true,"schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrSemanticResource"],"effectiveId":"http://schema.org/name"}]}