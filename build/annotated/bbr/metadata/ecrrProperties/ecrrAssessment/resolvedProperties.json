{"defs":{"0":[{"path":["schema:identifier"],"id":"http://schema.org/identifier","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:identifier","schema:propertyID"],"id":"http://schema.org/propertyID","description":"In this context for the schema:PropertyValue, this field is an identifier for the identifier schema, e.g. DOI, ARK.  Get values from https://registry.identifiers.org/registry/ for interoperability. URI-shape values MUST be serialized as JSON-LD IRI references ({\"@id\":\"...\"}) so they participate in RDF entailment; free-label strings remain valid as strings.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/propertyID"},{"path":["schema:identifier","schema:url"],"id":"http://schema.org/url","description":"web-resolveable string for the identifier; host name part is location of a resolver that will return some representation for the given identifier value. E.g. https://doi.org/10.5066/F7VX0DMQ ","schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/url"},{"path":["schema:identifier","schema:value"],"id":"http://schema.org/value","description":"the identifier string. E.g. 10.5066/F7VX0DMQ","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/value"},{"path":["schema:inDefinedTermSet"],"id":"http://schema.org/inDefinedTermSet","description":"The controlled vocabulary responsible for this keyword, as EITHER a plain URI string identifying the vocabulary, OR an object reference ({\"@id\": \"<uri>\"}) to a vocabulary defined elsewhere in the document. Both forms are already in use across CDIF profiles and downstream ADA building blocks; permitting only the string form made the object form - the natural JSON-LD spelling of a reference - invalid, while this class's own union-type policy above explicitly anticipates both.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/inDefinedTermSet"},{"path":["schema:name"],"id":"http://schema.org/name","description":"text label for the term that is useful to human user","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/name"},{"path":["schema:termCode"],"id":"http://schema.org/termCode","description":"A representative code for this keyword in the controlled vocabulary. Analogous to skos:Notation","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/termCode"}]},"properties":[{"path":["ecrro:ECRRO_0000138"],"id":"http://cor.esipfed.org/ont/earthcube/ECRRO_0000138","description":"Maturity state of the resource. Value is a DefinedTerm from the MTU (Maturity) vocabulary (e.g. In production, Alpha, Planning).","schema_type":"object","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://cor.esipfed.org/ont/earthcube/ECRRO_0000138"},{"path":["ecrro:ECRRO_0000138","schema:propertyID"],"id":"http://schema.org/propertyID","required":true,"schema_type":"string","const":"ecrro:ECRRO_0000138","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/propertyID"},{"path":["ecrro:ECRRO_0000138","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/name"},{"path":["ecrro:ECRRO_0000138","schema:value"],"id":"http://schema.org/value","required":true,"sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"ref":"0","effectiveId":"http://schema.org/value"},{"path":["ecrro:ECRRO_0000219"],"id":"http://cor.esipfed.org/ont/earthcube/ECRRO_0000219","description":"Expected lifetime of the resource. Value is a DefinedTerm from the ELT (Expected Lifetime) vocabulary (e.g. Long-term, >5 years, 1-5 years).","schema_type":"object","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://cor.esipfed.org/ont/earthcube/ECRRO_0000219"},{"path":["ecrro:ECRRO_0000219","schema:propertyID"],"id":"http://schema.org/propertyID","required":true,"schema_type":"string","const":"ecrro:ECRRO_0000219","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/propertyID"},{"path":["ecrro:ECRRO_0000219","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/name"},{"path":["ecrro:ECRRO_0000219","schema:value"],"id":"http://schema.org/value","required":true,"sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"ref":"0","effectiveId":"http://schema.org/value"},{"path":["ecrro:ECRRO_0000017"],"id":"http://cor.esipfed.org/ont/earthcube/ECRRO_0000017","description":"Current usage level of the resource. Value is a DefinedTerm from the UBA (Usage) vocabulary (e.g. Wide usage, Some usage, Low usage).","schema_type":"object","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://cor.esipfed.org/ont/earthcube/ECRRO_0000017"},{"path":["ecrro:ECRRO_0000017","schema:propertyID"],"id":"http://schema.org/propertyID","required":true,"schema_type":"string","const":"ecrro:ECRRO_0000017","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/propertyID"},{"path":["ecrro:ECRRO_0000017","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/name"},{"path":["ecrro:ECRRO_0000017","schema:value"],"id":"http://schema.org/value","required":true,"sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"ref":"0","effectiveId":"http://schema.org/value"},{"path":["ecrro:ECRRO_0000218"],"id":"http://cor.esipfed.org/ont/earthcube/ECRRO_0000218","description":"Stewardship or maintainer of the resource. Value is an agent (Person or Organization) or array of agents responsible for maintenance.","schema_type":"object","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://cor.esipfed.org/ont/earthcube/ECRRO_0000218"},{"path":["ecrro:ECRRO_0000218","schema:propertyID"],"id":"http://schema.org/propertyID","required":true,"schema_type":"string","const":"ecrro:ECRRO_0000218","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/propertyID"},{"path":["ecrro:ECRRO_0000218","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/name"},{"path":["ecrro:ECRRO_0000218","schema:value"],"id":"http://schema.org/value","required":true,"sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/value"},{"path":["ecrro:ECRRO_0000600"],"id":"http://cor.esipfed.org/ont/earthcube/ECRRO_0000600","description":"Primary publication about the resource. Value is a citation string.","schema_type":"object","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://cor.esipfed.org/ont/earthcube/ECRRO_0000600"},{"path":["ecrro:ECRRO_0000600","schema:propertyID"],"id":"http://schema.org/propertyID","required":true,"schema_type":"string","const":"ecrro:ECRRO_0000600","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/propertyID"},{"path":["ecrro:ECRRO_0000600","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/name"},{"path":["ecrro:ECRRO_0000600","schema:value"],"id":"http://schema.org/value","required":true,"schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/value"},{"path":["ecrro:ECRRO_0001301"],"id":"http://cor.esipfed.org/ont/earthcube/ECRRO_0001301","description":"Registration metadata recording who registered the resource and when. Value is a StructuredValue with contributor (Person) and datePublished.","schema_type":"object","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://cor.esipfed.org/ont/earthcube/ECRRO_0001301"},{"path":["ecrro:ECRRO_0001301","schema:propertyID"],"id":"http://schema.org/propertyID","required":true,"schema_type":"string","const":"ecrro:ECRRO_0001301","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/propertyID"},{"path":["ecrro:ECRRO_0001301","schema:name"],"id":"http://schema.org/name","schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/name"},{"path":["ecrro:ECRRO_0001301","schema:value"],"id":"http://schema.org/value","required":true,"schema_type":"object","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/value"},{"path":["ecrro:ECRRO_0001301","schema:value","schema:additionalType"],"id":"http://schema.org/additionalType","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/additionalType"},{"path":["ecrro:ECRRO_0001301","schema:value","schema:contributor"],"id":"http://schema.org/contributor","required":true,"sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/contributor"},{"path":["ecrro:ECRRO_0001301","schema:value","schema:datePublished"],"id":"http://schema.org/datePublished","required":true,"schema_type":"string","sources":["bblocks://ecrr.bbr.metadata.ecrrProperties.ecrrAssessment"],"effectiveId":"http://schema.org/datePublished"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:sameAs"],"id":"http://schema.org/sameAs","description":"other identifiers for the person","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/sameAs"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:contactPoint"],"id":"http://schema.org/contactPoint","description":"An email address or a contact web page (a form, an issue tracker), or both; at least one is required. Schema.org also allows telephone and postal contacts. A URL-only contact is ordinary in DCAT (a vcard:Kind with only vcard:hasURL), so requiring email made such records invalid.","schema_type":"object","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/contactPoint"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:contactPoint","schema:url"],"id":"http://schema.org/url","schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/url"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:contactPoint","schema:email"],"id":"http://schema.org/email","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/email"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:affiliation"],"id":"http://schema.org/affiliation","description":"if affiliation is present, value must be a schema:Organization.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/affiliation"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:affiliation","schema:sameAs"],"id":"http://schema.org/sameAs","description":"other identifiers for the organization","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/sameAs"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:affiliation","schema:identifier"],"id":"http://schema.org/identifier","description":"identifier for organization","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/identifier"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:affiliation","schema:description"],"id":"http://schema.org/description","description":"additional information about the agent or their relation to the described resource","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/description"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:affiliation","schema:alternateName"],"id":"http://schema.org/alternateName","description":"other labels by which the organization might be known. A list when there are several; a single label may be a plain string, as JSON-LD framing writes a one-item list.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/alternateName"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:affiliation","schema:name"],"id":"http://schema.org/name","description":"string label for organization that is meaningful for human users","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/name"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:affiliation","schema:additionalType"],"id":"http://schema.org/additionalType","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.organization"],"effectiveId":"http://schema.org/additionalType"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:affiliation","schema:additionalType","skos:narrower"],"id":"http://www.w3.org/2004/02/skos/core#narrower","description":"Narrower (child) concepts in the hierarchy. Items are inline concept objects or @id references.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#narrower"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:affiliation","schema:additionalType","skos:broader"],"id":"http://www.w3.org/2004/02/skos/core#broader","description":"Broader (parent) concepts in the hierarchy. Items are inline concept objects or @id references.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#broader"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:affiliation","schema:additionalType","skos:topConceptOf"],"id":"http://www.w3.org/2004/02/skos/core#topConceptOf","description":"Concept scheme(s) for which this is a top concept.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#topConceptOf"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:affiliation","schema:additionalType","skos:inScheme"],"id":"http://www.w3.org/2004/02/skos/core#inScheme","description":"Concept scheme(s) this concept belongs to.","required":true,"sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#inScheme"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:affiliation","schema:additionalType","skos:editorialNote"],"id":"http://www.w3.org/2004/02/skos/core#editorialNote","description":"Note for editors and maintainers.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#editorialNote"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:affiliation","schema:additionalType","skos:changeNote"],"id":"http://www.w3.org/2004/02/skos/core#changeNote","description":"Note documenting a change.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#changeNote"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:affiliation","schema:additionalType","skos:historyNote"],"id":"http://www.w3.org/2004/02/skos/core#historyNote","description":"Note about past state or use.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#historyNote"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:affiliation","schema:additionalType","skos:note"],"id":"http://www.w3.org/2004/02/skos/core#note","description":"General note about this concept.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#note"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:affiliation","schema:additionalType","skos:scopeNote"],"id":"http://www.w3.org/2004/02/skos/core#scopeNote","description":"Note clarifying meaning and/or intended use.","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#scopeNote"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:affiliation","schema:additionalType","skos:definition"],"id":"http://www.w3.org/2004/02/skos/core#definition","description":"Formal explanation of the meaning of this concept.","required":true,"sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#definition"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:affiliation","schema:additionalType","skos:notation"],"id":"http://www.w3.org/2004/02/skos/core#notation","description":"Classification code for this concept within a scheme (a single notation string, consistent with CdifCodelistConcept).","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#notation"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:affiliation","schema:additionalType","skos:prefLabel"],"id":"http://www.w3.org/2004/02/skos/core#prefLabel","description":"Preferred lexical label for this concept. A single string, a single language-tagged value, or an array of language-tagged values. Each language should appear at most once.","required":true,"sources":["bblocks://cdif.bbr.metadata.skosProperties.skosConcept"],"effectiveId":"http://www.w3.org/2004/02/skos/core#prefLabel"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:alternateName"],"id":"http://schema.org/alternateName","description":"other labels by which the person might be known. A list when there are several; a single label may be a plain string, as JSON-LD framing writes a one-item list.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/alternateName"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:identifier"],"id":"http://schema.org/identifier","description":"identifier for person, recommend ORCID","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/identifier"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:description"],"id":"http://schema.org/description","description":"additional information about the agent or their relation to the described resource","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/description"},{"path":["ecrro:ECRRO_0000218","schema:value","schema:name"],"id":"http://schema.org/name","description":"string label for person that is meaningful for human users, should format consistently. Recommend 'Family Name, Given name' format.","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.person"],"effectiveId":"http://schema.org/name"}]}