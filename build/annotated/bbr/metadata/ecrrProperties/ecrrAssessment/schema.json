{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ECRR Resource Assessment Properties",
  "description": "ECRR-specific properties for assessing resource maturity, expected lifetime, usage level, stewardship, primary publication, and registration metadata. These use the PropertyValue pattern with ECRRO property identifiers as top-level keys. The value field contains a DefinedTerm from a controlled vocabulary, an agent reference, or a string.",
  "type": "object",
  "properties": {
    "ecrro:ECRRO_0000138": {
      "description": "Maturity state of the resource. Value is a DefinedTerm from the MTU (Maturity) vocabulary (e.g. In production, Alpha, Planning).",
      "type": "object",
      "properties": {
        "@type": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "contains": {
            "const": "schema:PropertyValue"
          },
          "minItems": 1,
          "default": [
            "schema:PropertyValue"
          ]
        },
        "schema:propertyID": {
          "type": "string",
          "const": "ecrro:ECRRO_0000138",
          "x-jsonld-id": "http://schema.org/propertyID"
        },
        "schema:name": {
          "type": "string",
          "default": "has maturity state",
          "x-jsonld-id": "http://schema.org/name"
        },
        "schema:value": {
          "$ref": "#/$defs/DefinedTerm",
          "x-jsonld-id": "http://schema.org/value"
        }
      },
      "required": [
        "@type",
        "schema:propertyID",
        "schema:value"
      ],
      "x-jsonld-id": "http://cor.esipfed.org/ont/earthcube/ECRRO_0000138"
    },
    "ecrro:ECRRO_0000219": {
      "description": "Expected lifetime of the resource. Value is a DefinedTerm from the ELT (Expected Lifetime) vocabulary (e.g. Long-term, >5 years, 1-5 years).",
      "type": "object",
      "properties": {
        "@type": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "contains": {
            "const": "schema:PropertyValue"
          },
          "minItems": 1,
          "default": [
            "schema:PropertyValue"
          ]
        },
        "schema:propertyID": {
          "type": "string",
          "const": "ecrro:ECRRO_0000219",
          "x-jsonld-id": "http://schema.org/propertyID"
        },
        "schema:name": {
          "type": "string",
          "default": "expected lifetime",
          "x-jsonld-id": "http://schema.org/name"
        },
        "schema:value": {
          "$ref": "#/$defs/DefinedTerm",
          "x-jsonld-id": "http://schema.org/value"
        }
      },
      "required": [
        "@type",
        "schema:propertyID",
        "schema:value"
      ],
      "x-jsonld-id": "http://cor.esipfed.org/ont/earthcube/ECRRO_0000219"
    },
    "ecrro:ECRRO_0000017": {
      "description": "Current usage level of the resource. Value is a DefinedTerm from the UBA (Usage) vocabulary (e.g. Wide usage, Some usage, Low usage).",
      "type": "object",
      "properties": {
        "@type": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "contains": {
            "const": "schema:PropertyValue"
          },
          "minItems": 1,
          "default": [
            "schema:PropertyValue"
          ]
        },
        "schema:propertyID": {
          "type": "string",
          "const": "ecrro:ECRRO_0000017",
          "x-jsonld-id": "http://schema.org/propertyID"
        },
        "schema:name": {
          "type": "string",
          "default": "Usage",
          "x-jsonld-id": "http://schema.org/name"
        },
        "schema:value": {
          "$ref": "#/$defs/DefinedTerm",
          "x-jsonld-id": "http://schema.org/value"
        }
      },
      "required": [
        "@type",
        "schema:propertyID",
        "schema:value"
      ],
      "x-jsonld-id": "http://cor.esipfed.org/ont/earthcube/ECRRO_0000017"
    },
    "ecrro:ECRRO_0000218": {
      "description": "Stewardship or maintainer of the resource. Value is an agent (Person or Organization) or array of agents responsible for maintenance.",
      "type": "object",
      "properties": {
        "@type": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "contains": {
            "const": "schema:PropertyValue"
          },
          "minItems": 1,
          "default": [
            "schema:PropertyValue"
          ]
        },
        "schema:propertyID": {
          "type": "string",
          "const": "ecrro:ECRRO_0000218",
          "x-jsonld-id": "http://schema.org/propertyID"
        },
        "schema:name": {
          "type": "string",
          "default": "Stewardship",
          "x-jsonld-id": "http://schema.org/name"
        },
        "schema:value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Person"
            },
            {
              "$ref": "#/$defs/Organization"
            },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Person"
                  },
                  {
                    "$ref": "#/$defs/Organization"
                  }
                ]
              }
            }
          ],
          "x-jsonld-id": "http://schema.org/value"
        }
      },
      "required": [
        "@type",
        "schema:propertyID",
        "schema:value"
      ],
      "x-jsonld-id": "http://cor.esipfed.org/ont/earthcube/ECRRO_0000218"
    },
    "ecrro:ECRRO_0000600": {
      "description": "Primary publication about the resource. Value is a citation string.",
      "type": "object",
      "properties": {
        "@type": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "contains": {
            "const": "schema:PropertyValue"
          },
          "minItems": 1,
          "default": [
            "schema:PropertyValue"
          ]
        },
        "schema:propertyID": {
          "type": "string",
          "const": "ecrro:ECRRO_0000600",
          "x-jsonld-id": "http://schema.org/propertyID"
        },
        "schema:name": {
          "type": "string",
          "default": "primary publication",
          "x-jsonld-id": "http://schema.org/name"
        },
        "schema:value": {
          "type": "string",
          "x-jsonld-id": "http://schema.org/value"
        }
      },
      "required": [
        "@type",
        "schema:propertyID",
        "schema:value"
      ],
      "x-jsonld-id": "http://cor.esipfed.org/ont/earthcube/ECRRO_0000600"
    },
    "ecrro:ECRRO_0001301": {
      "description": "Registration metadata recording who registered the resource and when. Value is a StructuredValue with contributor (Person) and datePublished.",
      "type": "object",
      "properties": {
        "@type": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "contains": {
            "const": "schema:PropertyValue"
          },
          "minItems": 1,
          "default": [
            "schema:PropertyValue"
          ]
        },
        "schema:propertyID": {
          "type": "string",
          "const": "ecrro:ECRRO_0001301",
          "x-jsonld-id": "http://schema.org/propertyID"
        },
        "schema:name": {
          "type": "string",
          "default": "registration metadata",
          "x-jsonld-id": "http://schema.org/name"
        },
        "schema:value": {
          "type": "object",
          "properties": {
            "@type": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "contains": {
                "const": "schema:StructuredValue"
              },
              "minItems": 1,
              "default": [
                "schema:StructuredValue"
              ]
            },
            "schema:additionalType": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "ecrro:ECRRO_0000156"
                },
                {
                  "type": "array",
                  "contains": {
                    "const": "ecrro:ECRRO_0000156"
                  },
                  "minItems": 1
                }
              ],
              "x-jsonld-id": "http://schema.org/additionalType"
            },
            "schema:contributor": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Person"
                    },
                    {
                      "$ref": "#/$defs/Organization"
                    }
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/Person"
                      },
                      {
                        "$ref": "#/$defs/Organization"
                      }
                    ]
                  }
                }
              ],
              "x-jsonld-id": "http://schema.org/contributor"
            },
            "schema:datePublished": {
              "type": "string",
              "x-jsonld-id": "http://schema.org/datePublished"
            }
          },
          "required": [
            "@type",
            "schema:contributor",
            "schema:datePublished"
          ],
          "x-jsonld-id": "http://schema.org/value"
        }
      },
      "required": [
        "@type",
        "schema:propertyID",
        "schema:value"
      ],
      "x-jsonld-id": "http://cor.esipfed.org/ont/earthcube/ECRRO_0001301"
    }
  },
  "$defs": {
    "DefinedTerm": {
      "$ref": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/annotated/bbr/metadata/schemaorgProperties/definedTerm/schema.json"
    },
    "Person": {
      "$ref": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/annotated/bbr/metadata/schemaorgProperties/person/schema.json"
    },
    "Organization": {
      "$ref": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/annotated/bbr/metadata/schemaorgProperties/organization/schema.json"
    }
  },
