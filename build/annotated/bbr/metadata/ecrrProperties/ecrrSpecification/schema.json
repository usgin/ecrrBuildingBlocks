{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ECRR Specification-Specific Properties",
  "description": "Properties specific to specification resources in ECRR. For resources with mainEntity pointing to ECRRO_0000204 (Specification). Includes profile/parent specification references and specification subtype classification via SPKT vocabulary entries in mainEntity.",
  "type": "object",
  "properties": {
    "ecrro:ECRRO_0000501": {
      "description": "Parent specifications that this specification profiles or extends. PropertyValue wrapping an array of labeled links pointing to the parent specification documents.",
      "type": "object",
      "properties": {
        "@type": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "contains": {
            "const": "schema:PropertyValue"
          },
          "minItems": 1,
          "default": [
            "schema:PropertyValue"
          ]
        },
        "schema:propertyID": {
          "type": "string",
          "const": "ecrro:ECRRO_0000501",
          "x-jsonld-id": "http://schema.org/propertyID"
        },
        "schema:name": {
          "type": "string",
          "default": "profile of",
          "x-jsonld-id": "http://schema.org/name"
        },
        "schema:value": {
          "anyOf": [
            {
              "$ref": "#/$defs/LabeledLink"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/LabeledLink"
              }
            }
          ],
          "x-jsonld-id": "http://schema.org/value"
        }
      },
      "required": [
        "@type",
        "schema:propertyID",
        "schema:value"
      ],
      "x-jsonld-id": "http://cor.esipfed.org/ont/earthcube/ECRRO_0000501"
    }
  },
  "$defs": {
    "LabeledLink": {
      "$ref": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/annotated/bbr/metadata/schemaorgProperties/labeledLink/schema.json"
    }
  },
  "x-jsonld-extra-terms": {
    "ecrr": "https://n2t.net/ark:/23942/g2"
  },
  "x-jsonld-prefixes": {
    "schema": "http://schema.org/",
    "ecrro": "http://cor.esipfed.org/ont/earthcube/",
    "dct": "http://purl.org/dc/terms/"
  },
  "x-bblocks-metadata": {
    "itemIdentifier": "ecrr.bbr.metadata.ecrrProperties.ecrrSpecification",
    "register": "https://usgin.github.io/ecrrBuildingBlocks/build/register.json",
    "version": "0.1",
    "dateOfLastChange": "2026-11-14"
  }
}